# Copy this file to docker-compose.env and fill in your values, then:
#   docker compose up -d
# docker-compose.env is gitignored — never commit your real API key.
#
# Every variable the bare-metal install supports also works here — this
# file lists all of them for full configuration freedom, with only the
# genuinely important ones active by default. Everything else is
# commented out at its default value; uncomment and change only what you
# actually need. See "Configuration" in the README for what each one
# does in more detail.

# --- Required -----------------------------------------------------------
# Get yours at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_api_key_here

# Any secret-like value in this file (the API key above, the fallback
# key, the CrowdSec bouncer key, the shared secret, notification
# tokens/webhook URLs) can instead be provided via a file mounted into
# the container, using the Docker secrets convention: set "{VAR}_FILE"
# to the in-container path instead of the value itself — see the
# commented "volumes:" entry in docker-compose.yml for how to mount one.
# If both are set, the _FILE variant wins. Example:
# ABUSEIPDB_API_KEY_FILE=/run/secrets/abuseipdb_api_key

# --- Already set as image defaults, shown here for reference only -------
# (baked into the Dockerfile — override only if you know you need to)
# ABUSEIPDB_LISTEN_ADDRESS=0.0.0.0
# ABUSEIPDB_PROXY_PORT=9999
# ABUSEIPDB_CACHE_FILE=/var/lib/abuseipdb-proxy/cache.db
# ABUSEIPDB_ENABLE_HEALTH=true

# --- Cache backend --------------------------------------------------------
# SQLite is the only cache backend (ABUSEIPDB_CACHE_BACKEND=json was
# removed entirely in 3.0.0 — see CHANGELOG.md). Migrating an old
# cache.json from a custom path: 'docker compose exec abuseipdb-proxy
# python3 abuseipdb_proxy.py --migrate-to-sqlite /path/to/old/cache.json'
# ABUSEIPDB_SQLITE_JOURNAL_MODE=WAL
# ABUSEIPDB_SQLITE_SYNCHRONOUS=NORMAL

# --- Dedup / escalation / retry timing -------------------------------------
# ABUSEIPDB_REPORT_WINDOW=905
# ABUSEIPDB_REPORT_WINDOW_LOW=905
# ABUSEIPDB_REPORT_WINDOW_MEDIUM=905
# ABUSEIPDB_REPORT_WINDOW_HIGH=905
# ABUSEIPDB_MAX_RETRIES=3
# ABUSEIPDB_RETRY_DELAY=900
# ABUSEIPDB_DRY_RUN=false

# --- Private/reserved IP filtering (on by default) -------------------------
# ABUSEIPDB_IGNORE_PRIVATE=true
# ABUSEIPDB_IGNORE_IPS=

# --- Logging ----------------------------------------------------------------
# ABUSEIPDB_VERBOSE_LOGGING=false
# ABUSEIPDB_SUMMARY_INTERVAL=300
# "json" pairs well with a container log driver shipping to Loki/ELK/etc.:
# ABUSEIPDB_LOG_FORMAT=text

# --- Orphaned pending/retry reconciliation -----------------------------
# Periodically re-arms a pending/retry row with no in-memory timer in
# this process — mainly for --reconcile, whose own retries are lost when
# that short-lived CLI process exits. 0 disables. Default 60:
# ABUSEIPDB_ORPHAN_RESCAN_INTERVAL=60
# Warns once (via your notification backend(s) above) if the combined
# pending+retry backlog stays >= this size continuously for at least
# ABUSEIPDB_RETRY_BACKLOG_WARN_AGE seconds — usually means AbuseIPDB
# itself is down/erroring. 0 disables. Defaults: size 20, age 900s:
# ABUSEIPDB_RETRY_BACKLOG_WARN_SIZE=20
# ABUSEIPDB_RETRY_BACKLOG_WARN_AGE=900

# --- Quota tracking -----------------------------------------------------
# ABUSEIPDB_QUOTA_WARN_THRESHOLD=50
# Reserve part of the daily quota for higher-severity findings — see
# "Configuration" in the README. Both 0 (disabled) by default:
# ABUSEIPDB_QUOTA_RESERVE_MEDIUM=0
# ABUSEIPDB_QUOTA_RESERVE_HIGH=0
# A held-back report is rescheduled to re-check after this many seconds
# rather than being dropped. Default 300:
# ABUSEIPDB_QUOTA_RESERVE_RECHECK_DELAY=300

# --- Per-category report windows (finer than the severity tiers above) ----
# ABUSEIPDB_REPORT_WINDOW_CATEGORIES=

# --- Local-port access control ----------------------------------------
# Extra layers on top of the container's own network isolation (see
# "Networking" above) — not required, but useful defense-in-depth,
# especially if you publish the port to the host. Both off by default:
# ABUSEIPDB_ALLOWED_SOURCE_IPS=
# ABUSEIPDB_SHARED_SECRET=

# --- Concurrent-request ceiling (safety net, not a normal throttle) -------
# 0 disables. Rejects with 503 immediately rather than queuing:
# ABUSEIPDB_MAX_CONCURRENT_REQUESTS=50

# --- AbuseIPDB whitelist pre-check (off by default) -------------------
# ABUSEIPDB_SKIP_WHITELISTED=false
# ABUSEIPDB_WHITELIST_CACHE_TTL=86400

# --- Comment scrubbing (off by default) --------------------------------
# ABUSEIPDB_COMMENT_SCRUB_PATTERNS=
# ABUSEIPDB_COMMENT_SCRUB_REPLACEMENT=[redacted]

# --- Fallback API key (off by default) ----------------------------------
# ABUSEIPDB_API_KEY_FALLBACK=

# --- CrowdSec decision reconciliation (--reconcile, off by default) -------
# 127.0.0.1 is almost never correct inside Docker — point this at wherever
# CrowdSec's container is actually reachable from this one, e.g.
# http://crowdsec:8080 if it's on the same Docker network. See
# "Networking" above and "--reconcile" in the README. Categories/severity
# come from the decision's own scenario name; RECONCILE_SEVERITY/_CATEGORIES
# below are only a fallback for decisions with no scenario name at all:
# ABUSEIPDB_CROWDSEC_LAPI_URL=http://127.0.0.1:8080
# ABUSEIPDB_CROWDSEC_BOUNCER_KEY=
# ABUSEIPDB_RECONCILE_SEVERITY=2
# ABUSEIPDB_RECONCILE_CATEGORIES=15

# --- Backups (--backup CLI flag / a manual cron inside the container) ------
# ABUSEIPDB_BACKUP_RETENTION=14

# --- Observability endpoints -------------------------------------------
# ABUSEIPDB_ENABLE_METRICS=true is set directly in docker-compose.yml,
# not here — see the `environment:` block there.
# ABUSEIPDB_NOTIFY_ON_START=false

# --- Alerting — configure any combination, each activates itself once its
# required variable(s) are set. Test with:
#   docker compose exec abuseipdb-proxy python3 abuseipdb_proxy.py --test-notify
# ABUSEIPDB_NOTIFY_NAME=CrowdSec Smart AbuseIPDB Proxy
# ABUSEIPDB_GOTIFY_URL=https://gotify.example.com
# ABUSEIPDB_GOTIFY_TOKEN=
# ABUSEIPDB_NTFY_URL=https://ntfy.example.com/my-topic
# ABUSEIPDB_NTFY_TOKEN=
# ABUSEIPDB_WEBHOOK_URL=
# ABUSEIPDB_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ABUSEIPDB_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Matrix needs all three:
# ABUSEIPDB_MATRIX_HOMESERVER_URL=https://matrix.org
# ABUSEIPDB_MATRIX_ACCESS_TOKEN=
# ABUSEIPDB_MATRIX_ROOM_ID=!roomid:matrix.org
# Telegram needs both:
# ABUSEIPDB_TELEGRAM_BOT_TOKEN=
# ABUSEIPDB_TELEGRAM_CHAT_ID=
# Home Assistant needs both (native REST API call, no bridge needed):
# ABUSEIPDB_HOMEASSISTANT_URL=https://homeassistant.local:8123
# ABUSEIPDB_HOMEASSISTANT_TOKEN=
# ABUSEIPDB_HOMEASSISTANT_NOTIFY_SERVICE=notify
